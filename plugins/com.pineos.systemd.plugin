# =============================================================================
#  Plugin: com.pineos.systemd
#  PineOS pkg plugin — systemd / systemctl service helpers
#
#  Requires: systemctl  (standard on PineOS / most Arch installs)
#
#  Install:  pkg plugin install com.pineos.systemd
#  Enable:   Add 'com.pineos.systemd' under [plugins] in pkg.conf
# =============================================================================

PLUGIN_NAME="systemd"
PLUGIN_VERSION="1.0.0"
PLUGIN_AUTHOR="The Pine Project"
PLUGIN_DESC="systemd / systemctl helpers — manage services without typing sudo systemctl"

PLUGIN_COMMANDS=(
    "svc-start"
    "svc-stop"
    "svc-restart"
    "svc-reload"
    "svc-enable"
    "svc-disable"
    "svc-status"
    "svc-log"
    "svc-list"
    "svc-mask"
    "svc-unmask"
    "svc-daemon-reload"
)

plugin_help() {
    printf "    ${GREEN}%-32s${NC} %s\n" "svc-start    <service>"   "Start a service"
    printf "    ${GREEN}%-32s${NC} %s\n" "svc-stop     <service>"   "Stop a service"
    printf "    ${GREEN}%-32s${NC} %s\n" "svc-restart  <service>"   "Restart a service"
    printf "    ${GREEN}%-32s${NC} %s\n" "svc-reload   <service>"   "Reload service config (SIGHUP)"
    printf "    ${GREEN}%-32s${NC} %s\n" "svc-enable   <service>"   "Enable + start a service at boot"
    printf "    ${GREEN}%-32s${NC} %s\n" "svc-disable  <service>"   "Disable a service (stop at boot)"
    printf "    ${GREEN}%-32s${NC} %s\n" "svc-status   <service>"   "Show service status"
    printf "    ${GREEN}%-32s${NC} %s\n" "svc-log      <service>"   "Follow journalctl log for service"
    printf "    ${GREEN}%-32s${NC} %s\n" "svc-list     [--all]"     "List running (or all) services"
    printf "    ${GREEN}%-32s${NC} %s\n" "svc-mask     <service>"   "Mask (hard-disable) a service"
    printf "    ${GREEN}%-32s${NC} %s\n" "svc-unmask   <service>"   "Unmask a service"
    printf "    ${GREEN}%-32s${NC} %s\n" "svc-daemon-reload"        "Reload systemd unit files"
}

_svc_require() {
    command -v systemctl &>/dev/null && return 0
    err "[systemd] systemctl not found — is systemd running?"
    return 1
}

_svc_name() {
    # Append .service if no dot (unit type) is in the name
    local name="$1"
    [[ "$name" =~ \. ]] && echo "$name" || echo "${name}.service"
}

plugin_cmd_svc-start() {
    [[ -z "${1:-}" ]] && { err "[systemd] Usage: pkg svc-start <service>"; return 1; }
    _svc_require || return 1
    local svc; svc=$(_svc_name "$1")
    sudo systemctl start "$svc" \
        && ok "[systemd] Started: $svc" \
        || err "[systemd] Failed to start: $svc"
}

plugin_cmd_svc-stop() {
    [[ -z "${1:-}" ]] && { err "[systemd] Usage: pkg svc-stop <service>"; return 1; }
    _svc_require || return 1
    local svc; svc=$(_svc_name "$1")
    sudo systemctl stop "$svc" \
        && ok "[systemd] Stopped: $svc" \
        || err "[systemd] Failed to stop: $svc"
}

plugin_cmd_svc-restart() {
    [[ -z "${1:-}" ]] && { err "[systemd] Usage: pkg svc-restart <service>"; return 1; }
    _svc_require || return 1
    local svc; svc=$(_svc_name "$1")
    sudo systemctl restart "$svc" \
        && ok "[systemd] Restarted: $svc" \
        || err "[systemd] Failed to restart: $svc"
}

plugin_cmd_svc-reload() {
    [[ -z "${1:-}" ]] && { err "[systemd] Usage: pkg svc-reload <service>"; return 1; }
    _svc_require || return 1
    local svc; svc=$(_svc_name "$1")
    sudo systemctl reload "$svc" \
        && ok "[systemd] Reloaded: $svc" \
        || err "[systemd] Failed to reload: $svc"
}

plugin_cmd_svc-enable() {
    [[ -z "${1:-}" ]] && { err "[systemd] Usage: pkg svc-enable <service>"; return 1; }
    _svc_require || return 1
    local svc; svc=$(_svc_name "$1")
    sudo systemctl enable --now "$svc" \
        && ok "[systemd] Enabled + started: $svc" \
        || err "[systemd] Failed to enable: $svc"
}

plugin_cmd_svc-disable() {
    [[ -z "${1:-}" ]] && { err "[systemd] Usage: pkg svc-disable <service>"; return 1; }
    _svc_require || return 1
    local svc; svc=$(_svc_name "$1")
    sudo systemctl disable --now "$svc" \
        && ok "[systemd] Disabled + stopped: $svc" \
        || err "[systemd] Failed to disable: $svc"
}

plugin_cmd_svc-status() {
    [[ -z "${1:-}" ]] && { err "[systemd] Usage: pkg svc-status <service>"; return 1; }
    _svc_require || return 1
    local svc; svc=$(_svc_name "$1")
    systemctl status "$svc"
}

plugin_cmd_svc-log() {
    [[ -z "${1:-}" ]] && { err "[systemd] Usage: pkg svc-log <service>"; return 1; }
    _svc_require || return 1
    local svc; svc=$(_svc_name "$1")
    info "[systemd] Following logs for $svc  (Ctrl-C to stop)"
    journalctl -u "$svc" -f --no-pager
}

plugin_cmd_svc-list() {
    _svc_require || return 1
    if [[ "${1:-}" == "--all" ]]; then
        systemctl list-units --type=service --all
    else
        systemctl list-units --type=service --state=running
    fi
}

plugin_cmd_svc-mask() {
    [[ -z "${1:-}" ]] && { err "[systemd] Usage: pkg svc-mask <service>"; return 1; }
    _svc_require || return 1
    local svc; svc=$(_svc_name "$1")
    sudo systemctl mask "$svc" \
        && ok "[systemd] Masked: $svc" \
        || err "[systemd] Failed to mask: $svc"
}

plugin_cmd_svc-unmask() {
    [[ -z "${1:-}" ]] && { err "[systemd] Usage: pkg svc-unmask <service>"; return 1; }
    _svc_require || return 1
    local svc; svc=$(_svc_name "$1")
    sudo systemctl unmask "$svc" \
        && ok "[systemd] Unmasked: $svc" \
        || err "[systemd] Failed to unmask: $svc"
}

plugin_cmd_svc-daemon-reload() {
    _svc_require || return 1
    sudo systemctl daemon-reload \
        && ok "[systemd] Daemon reloaded" \
        || err "[systemd] daemon-reload failed"
}
