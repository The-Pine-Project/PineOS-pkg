# =============================================================================
#  Plugin: com.pineos.cargo
#  PineOS pkg plugin — Rust / cargo integration
#
#  Requires: cargo  (install via: pkg install rust  OR  https://rustup.rs)
#
#  Install:  pkg plugin install com.pineos.cargo
#  Enable:   Add 'com.pineos.cargo' under [plugins] in pkg.conf
# =============================================================================

PLUGIN_NAME="cargo"
PLUGIN_VERSION="1.0.0"
PLUGIN_AUTHOR="The Pine Project"
PLUGIN_DESC="Rust / cargo — install, remove and update Rust binaries via cargo"

PLUGIN_COMMANDS=(
    "cargo-install"
    "cargo-remove"
    "cargo-update"
    "cargo-list"
)

plugin_help() {
    printf "    ${GREEN}%-30s${NC} %s\n" "cargo-install <crate>"  "Install a Rust binary from crates.io"
    printf "    ${GREEN}%-30s${NC} %s\n" "cargo-remove  <crate>"  "Uninstall a cargo-installed binary"
    printf "    ${GREEN}%-30s${NC} %s\n" "cargo-update  [crate]"  "Update one or all installed cargo binaries"
    printf "    ${GREEN}%-30s${NC} %s\n" "cargo-list"             "List all cargo-installed binaries"
}

_cargo_require() {
    command -v cargo &>/dev/null && return 0
    err "[cargo] cargo not found."
    err "[cargo] Install Rust: pkg install rust"
    err "[cargo]          or : curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
    return 1
}

plugin_cmd_cargo-install() {
    [[ -z "${1:-}" ]] && { err "[cargo] Usage: pkg cargo-install <crate> [--features x,y] [-- extra args]"; return 1; }
    _cargo_require || return 1
    msg "[cargo] Installing ${BOLD}$1${NC} from crates.io..."
    cargo install "$@" \
        && ok "[cargo] Installed: $1" \
        || err "[cargo] Install failed: $1"
}

plugin_cmd_cargo-remove() {
    [[ -z "${1:-}" ]] && { err "[cargo] Usage: pkg cargo-remove <crate>"; return 1; }
    _cargo_require || return 1
    cargo uninstall "$@" \
        && ok "[cargo] Removed: $*" \
        || err "[cargo] Remove failed"
}

plugin_cmd_cargo-update() {
    _cargo_require || return 1
    if [[ -n "${1:-}" ]]; then
        msg "[cargo] Updating $1..."
        cargo install "$1" --force \
            && ok "[cargo] Updated: $1" \
            || err "[cargo] Update failed: $1"
    else
        if command -v cargo-install-update &>/dev/null; then
            msg "[cargo] Updating all installed binaries via cargo-install-update..."
            cargo install-update -a
        else
            msg "[cargo] cargo-install-update not found — reinstalling all to latest..."
            cargo install $(cargo install --list | grep -E '^[a-z]' | awk '{print $1}') --force 2>/dev/null || true
            info "[cargo] Tip: install cargo-update for smarter upgrades:"
            info "         pkg cargo-install cargo-update"
        fi
        ok "[cargo] All binaries updated"
    fi
}

plugin_cmd_cargo-list() {
    _cargo_require || return 1
    info "[cargo] Installed binaries (cargo install --list):"
    cargo install --list
}
