pkgname=pkg-stable
pkgver=1.1.0
pkgrel=4
pkgdesc="PineOS Package Manager — dual-repos, pull, build, and self-updating"
arch=('x86_64')
url="https://github.com/The-Pine-Project/PineOS-pkg"
license=('GPL')
depends=('pacman' 'bash' 'grep' 'sed' 'curl' 'git')
optdepends=(
    'paru: AUR support (preferred)'
    'yay: AUR support (fallback)'
    'vlock: terminal lock support'
    'makepkg: source build support'
)

source=('pkg.sh')
sha256sums=('SKIP')

package() {
    install -dm755 "${pkgdir}/usr/bin"
    install -dm755 "${pkgdir}/usr/share/pkg"

    # Install the main script
    install -m755 "${srcdir}/pkg.sh" "${pkgdir}/usr/bin/pkg"

    # Drop a copy of PKGBUILD so update-self can version-bump it in place
    install -m644 "${startdir}/PKGBUILD" "${pkgdir}/usr/share/pkg/PKGBUILD"
}
